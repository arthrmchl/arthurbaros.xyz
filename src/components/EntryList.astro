---
import RepeatIcon from './RepeatIcon.astro';
import ReviewIcon from './ReviewIcon.astro';
import Stars from './Stars.astro';
import { type JournalEntry, href, posterImage, abandonedLabel, fmtYears, typeLabel, logDate, isoDate, repeatLabel, seasonLabel } from '../lib/content';
interface Props { entries: JournalEntry[]; showType?: boolean }
const { entries, showType = true } = Astro.props;

// Journal à la Letterboxd : le mois n'est affiché qu'à la première entrée de chaque mois.
// Une date connue au mois ou à l'année près n'a pas de jour : son mois (ou son année) est toujours affiché.
const sameYear = new Set(entries.map(({ log }) => logDate(log.data).getUTCFullYear())).size <= 1;
const monthOf = (d: Date) =>
  d.toLocaleDateString('fr-FR', { month: 'short', ...(sameYear ? {} : { year: 'numeric' }), timeZone: 'UTC' });
let prev: string | undefined;
const rows = entries.map((e) => {
  const d = logDate(e.log.data);
  const precision = e.log.data.date ? e.log.data.datePrecision : 'day';
  const label = precision === 'year' ? String(d.getUTCFullYear()) : monthOf(d);
  const month = precision !== 'day' || label !== prev ? label : undefined;
  prev = label;
  return { ...e, d, precision, month, day: precision === 'day' ? d.getUTCDate() : undefined };
});
---
<ul class="entries">
  {rows.map(({ log, work, season, d, precision, month, day }) => {
    const image = season?.poster ?? work.data.poster;
    const type = work.data.type;
    // Série : « Titre · Saison 2 », sans la saison quand la série n'en a qu'une.
    const seasonName = season && seasonLabel(season);
    return (
      <li>
        <time class="date" datetime={isoDate(d, precision)}>
          <span class="month">{month}</span>
          {day && <span class="day">{day}</span>}
        </time>
        <a class="thumb" href={href(`/journal/${log.id}/`)} tabindex="-1" aria-hidden="true">
          {image ? <img {...posterImage(image, '2.75rem')} alt="" loading="lazy" /> : <span class="placeholder" />}
        </a>
        <div class="body">
          <a class="name" href={href(`/journal/${log.id}/`)}>{work.data.title}{seasonName && <><span class="sep">·</span>{seasonName}</>}</a>
          <span class="meta">
            {work.data.creator}<span class="inline-year">, {fmtYears(work.data)}</span>
            {showType && <> — <span class={`kind-${work.data.type}`}>{typeLabel[work.data.type]}</span></>}
          </span>
          {log.data.summary && <p class="summary">{log.data.summary}</p>}
        </div>
        <span class="year meta">{fmtYears(work.data)}</span>
        {log.data.rating !== undefined
          ? <Stars rating={log.data.rating} type={type} />
          : <span class="stars pending" title={season && !log.data.date ? 'Épisodes vus' : undefined}>
              {log.data.abandoned ? abandonedLabel(season) : log.data.date ? '—' : season ? `${season.seen.size}/${season.episodes}` : 'En cours'}
            </span>}
        <span class="repeat">{log.data.repeat && <RepeatIcon label={repeatLabel[type]} />}</span>
        <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
      </li>
    );
  })}
</ul>

<style>
  .entries { list-style: none; padding: 0; margin: 1.5rem 0; }
  .entries li { display: grid; grid-template-columns: 3rem 2.75rem 1fr 4.5rem 6.5rem 1.25rem 1.25rem; gap: 0 1.25rem; align-items: center;
    padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  /* Jour en grand, mois en étiquette au-dessus. */
  .date { display: flex; flex-direction: column; align-items: center; font-family: var(--sans); line-height: 1; }
  .month { font: 600 0.7rem var(--sans); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .month:empty { display: none; }
  .day { font-size: 1.6rem; font-weight: 300; color: var(--muted); }
  .thumb { display: block; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px var(--line), 0 2px 6px rgb(0 0 0 / 0.2); }
  .thumb img { display: block; width: 100%; height: auto; aspect-ratio: auto 2 / 3; }
  .placeholder { display: block; aspect-ratio: 2 / 3; background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .body { display: flex; flex-direction: column; min-width: 0; }
  .name { font-size: 1.25rem; font-weight: 600; line-height: 1.25; text-decoration: none; }
  .name:hover { text-decoration: underline; }
  .summary { margin: 0.25rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.4; }
  .year { text-align: right; }
  .entries :global(.stars) { font-size: 1.05rem; }
  /* Lecture en cours : à la place des étoiles. */
  .entries .pending { font: 600 0.9rem var(--sans); letter-spacing: 0; color: var(--ink); }
  .repeat, .review { display: flex; justify-content: center; }
  .inline-year { display: none; }

  /* Sur téléphone : l'année passe sous le titre, note et revisionnage sous le texte. */
  @media (max-width: 34rem) {
    .entries li { grid-template-columns: 2.25rem 2.5rem 1fr auto auto; grid-template-areas: 'date thumb body body body' 'date thumb stars repeat review';
      gap: 0.15rem 0.9rem; align-items: start; }
    .date { grid-area: date; } .thumb { grid-area: thumb; } .body { grid-area: body; }
    .entries :global(.stars) { grid-area: stars; } .repeat { grid-area: repeat; } .review { grid-area: review; }
    .year { display: none; } .inline-year { display: inline; }
    .day { font-size: 1.35rem; }
    .name { font-size: 1.1rem; }
  }
</style>
