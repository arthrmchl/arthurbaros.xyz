---
import { pageUrl } from '../lib/content';
// Navigation entre les pages d'une liste (journal, grilles d'affiches, listes). Rien n'est affiché s'il n'y a qu'une page.
// `root` : adresse de la page 1 (`/journal/`). Toujours la première et la dernière page, et les deux voisines de la page courante ;
// les trous de plus d'une page deviennent « … ».
interface Props { current: number; last: number; root: string }
const { current, last, root } = Astro.props;
const shown = [...new Set([1, current - 1, current, current + 1, last])].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
const pages = shown.flatMap((n, i) => {
  const gap = n - (shown[i - 1] ?? n - 1);
  return gap === 2 ? [n - 1, n] : gap > 2 ? ['…' as const, n] : [n];
});
---
{last > 1 && (
  <nav class="pagination" aria-label="Pages">
    {current > 1
      ? <a class="step" href={pageUrl(root, current - 1)} rel="prev">←<span class="word"> Précédente</span></a>
      : <span class="step" aria-hidden="true">←<span class="word"> Précédente</span></span>}
    <ol>
      {pages.map((n) => (
        <li>
          {n === '…'
            ? <span class="gap">…</span>
            : <a href={pageUrl(root, n)} aria-current={n === current ? 'page' : undefined} aria-label={`Page ${n}`}>{n}</a>}
        </li>
      ))}
    </ol>
    {current < last
      ? <a class="step" href={pageUrl(root, current + 1)} rel="next"><span class="word">Suivante </span>→</a>
      : <span class="step" aria-hidden="true"><span class="word">Suivante </span>→</span>}
  </nav>
)}

<style>
  .pagination { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 2rem 0 0; font: 0.95rem var(--sans); }
  .pagination ol { display: flex; gap: 0.25rem; list-style: none; padding: 0; margin: 0; }
  .pagination a, .gap { display: block; min-width: 2.2rem; padding: 0.3rem 0.5rem; border-radius: 4px; text-align: center; text-decoration: none; font-variant-numeric: tabular-nums; }
  .pagination a:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .pagination [aria-current='page'] { font-weight: 600; box-shadow: inset 0 0 0 1.5px currentColor; }
  .gap { color: var(--muted); min-width: auto; padding-inline: 0.2rem; }
  /* Pas de page précédente ou suivante : la place reste réservée, les numéros ne bougent pas. */
  span.step { visibility: hidden; }
  .step { white-space: nowrap; }
  @media (max-width: 34rem) {
    .pagination { gap: 0.25rem; font-size: 0.9rem; }
    .pagination .step { min-width: auto; padding-inline: 0.25rem; }
    /* Sur téléphone, les flèches seules (le nom reste lu par les lecteurs d'écran). */
    .word { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
