---
// Lignes de texte : l'entrée a une review rédigée (à la Letterboxd).
interface Props { label?: string }
const { label = 'Avec une review' } = Astro.props;
---
<svg class="review-icon" viewBox="0 0 24 24" role="img" aria-label={label}>
  <title>{label}</title>
  <path d="M3 5h18M3 10h18M3 15h18M3 20h11" />
</svg>

<style>
  .review-icon { display: block; width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--muted);
    stroke-width: 1.75; stroke-linecap: round; }
</style>
