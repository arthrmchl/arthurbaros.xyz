---
import type { CollectionEntry } from 'astro:content';
import LikeIcon from './LikeIcon.astro';
import Poster from './Poster.astro';
import Stars from './Stars.astro';
// Grille d'affiches menant aux fiches : pages Films / Livres / Séries, genres et personnes.
// `rating` : dernière note, affichée sous l'affiche, avec un cœur si ce passage a été aimé (`liked`) ; `badge` : étiquette sur l'affiche (« En cours »).
interface Props { items: { work: CollectionEntry<'works'>; rating?: number; liked?: boolean; badge?: string }[] }
const { items } = Astro.props;
---
<ul class="posters">
  {items.map(({ work, rating, liked, badge }) => rating !== undefined || liked
    ? <Poster work={work} badge={badge}>
        <span class="rated">
          {rating !== undefined && <Stars rating={rating} type={work.data.type} />}
          {liked && <LikeIcon type={work.data.type} />}
        </span>
      </Poster>
    : <Poster work={work} badge={badge} />)}
</ul>

<style>
  .posters { list-style: none; padding: 0; margin: 1.5rem 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr)); gap: 1rem; align-items: end; }
  .rated { display: flex; align-items: center; gap: 0.35rem; }
  @media (max-width: 34rem) {
    .posters { grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  }
</style>
