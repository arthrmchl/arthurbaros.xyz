---
import LikeIcon from './LikeIcon.astro';
import { fmtRuntime, capitalize, latestByWork, logDate } from '../lib/content';
// Bilan chiffré d'une année : une tuile par type d'œuvre et une pour les notes (avec les coups de cœur), puis la frise des mois.
// `entries` : les entrées de l'année (voir getJournal) ; `episodes` : épisodes vus dans l'année, saisons confondues,
// et `episodeMinutes` leur durée totale (épisodes dont la durée est renseignée).
type Kind = 'film' | 'livre' | 'serie';
interface Props {
  year: number;
  entries: {
    work: { id: string; data: { type: Kind; runtime?: number; seasons: { number: number }[] } };
    log: { data: { date?: Date; datePrecision?: 'year' | 'month' | 'day'; started?: Date; watched?: { date: Date }[]; rating?: number; liked: boolean; abandoned: boolean;
      venue?: 'cinema' | 'maison'; version?: 'vf' | 'vostfr'; accompanied?: boolean; language?: string } };
    season?: { number: number; complete: boolean };
  }[];
  episodes: number;
  episodeMinutes: number;
}
const { year, entries, episodes, episodeMinutes } = Astro.props;
const plural = (n: number, one: string, many: string) => `${n} ${n > 1 ? many : one}`;
const count = <T,>(list: T[], test: (x: T) => boolean) => list.filter(test).length;
/** [« 3 au cinéma », « 2 à la maison »], sans les catégories vides : une ligne, affichée avec des points médians. */
const LIKES: [string, string] = ['coup de cœur', 'coups de cœur'];
// Coups de cœur : une œuvre aimée à plusieurs passages (revisionnage, plusieurs saisons) ne compte qu'une fois,
// avec son passage aimé le plus récent (le journal va du plus récent au plus ancien).
const liked = latestByWork(entries.filter((e) => e.log.data.liked));
const likedOf = (kind: Kind) => count(liked, (e) => e.work.data.type === kind);
const split = (parts: [number, string, string?][]) => parts.filter(([n]) => n > 0).map(([n, one, many]) => plural(n, one, many ?? one));

const films = entries.filter((e) => e.work.data.type === 'film').map((e) => ({ ...e.log.data, runtime: e.work.data.runtime }));
const minutes = films.reduce((sum, f) => sum + (f.runtime ?? 0), 0);
const seasons = entries.filter((e) => e.season);
// Saisons terminées : celles suivies jusqu'au bout, plus toutes les saisons d'une série vue en entier (avis sur la série).
const seasonsDone = count(seasons, (e) => Boolean(e.season?.complete))
  + entries.filter((e) => e.work.data.type === 'serie' && !e.season).reduce((n, e) => n + e.work.data.seasons.length, 0);
// Séries terminées : vues en entier (avis sur la série) ou dont la dernière saison a été finie ; une série ne compte qu'une fois.
const seriesDone = new Set(entries.filter((e) => e.work.data.type === 'serie'
  && (e.season ? e.season.complete && e.season.number === e.work.data.seasons.at(-1)?.number : true)).map((e) => e.work)).size;
const books = entries.filter((e) => e.work.data.type === 'livre').map((e) => e.log.data);
const booksRead = count(books, (b) => Boolean(b.date) && !b.abandoned);
const languages = Object.entries(Object.groupBy(books.filter((b) => b.language), (b) => b.language!))
  .map(([lang, list]) => [list!.length, `en ${lang}`] as [number, string]);

const tiles = [
  films.length > 0 && {
    kind: 'film', value: films.length, label: films.length > 1 ? 'films vus' : 'film vu',
    lines: [
      minutes > 0 && [`${fmtRuntime(minutes)} de film`],
      split([[count(films, (f) => f.venue === 'cinema'), 'au cinéma'], [count(films, (f) => f.venue === 'maison'), 'à la maison']]),
      split([[count(films, (f) => f.version === 'vostfr'), 'en VOSTFR'], [count(films, (f) => f.version === 'vf'), 'en VF']]),
      [count(films, (f) => f.accompanied === false), count(films, (f) => f.accompanied === true)].some((n) => n > 0)
        && [`Seul : ${count(films, (f) => f.accompanied === false)}`, `Accompagné : ${count(films, (f) => f.accompanied === true)}`],
      split([[likedOf('film'), ...LIKES], [count(films, (f) => f.abandoned), 'abandonné', 'abandonnés']]),
    ],
  },
  (episodes > 0 || seasons.length > 0) && {
    kind: 'serie', value: episodes, label: episodes > 1 ? 'épisodes vus' : 'épisode vu',
    lines: [
      episodeMinutes > 0 && [`${fmtRuntime(episodeMinutes)} de série`],
      split([[seasonsDone, 'saison terminée', 'saisons terminées'], [seriesDone, 'série terminée', 'séries terminées'],
        [count(seasons, (e) => !e.log.data.date), 'en cours'], [count(seasons, (e) => e.log.data.abandoned), 'abandonnée', 'abandonnées']]),
      split([[likedOf('serie'), ...LIKES]]),
    ],
  },
  books.length > 0 && {
    kind: 'livre', value: booksRead, label: booksRead > 1 ? 'livres lus' : 'livre lu',
    lines: [
      split([[count(books, (b) => !b.date), 'en cours'], [likedOf('livre'), ...LIKES], [count(books, (b) => b.abandoned), 'abandonné', 'abandonnés']]),
      split(languages),
    ],
  },
].filter((t) => t !== false);

// Répartition des notes de 0 à 5, toutes œuvres confondues, et la part des coups de cœur dans chaque note (à la note du passage aimé retenu).
const ratings = entries.flatMap((e) => e.log.data.rating ?? []);
const likes = liked.length;
const histogram = [0, 1, 2, 3, 4, 5].map((r) => ({ rating: r, n: count(ratings, (x) => x === r), liked: count(liked, (e) => e.log.data.rating === r) }));
const maxRating = Math.max(1, ...histogram.map((h) => h.n));
const avg = ratings.length ? (ratings.reduce((s, r) => s + r, 0) / ratings.length).toFixed(1).replace('.', ',') : undefined;

// Frise des mois : les entrées rangées au mois de leur date dans le journal (logDate), empilées par type.
// Une entrée datée de l'année seulement (`2026`) n'a pas de mois : elle reste hors de la frise.
const MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
const SHORT = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const KINDS: { kind: Kind; one: string; many: string }[] = [
  { kind: 'film', one: 'film', many: 'films' }, { kind: 'serie', one: 'série', many: 'séries' }, { kind: 'livre', one: 'livre', many: 'livres' },
];
const dated = entries.filter((e) => e.log.data.datePrecision !== 'year');
const kinds = KINDS.filter(({ kind }) => dated.some((e) => e.work.data.type === kind));
// Année en cours (à la date du build) : les mois à venir sont dessinés à part, pour ne pas passer pour des mois vides.
const now = new Date();
const lastMonth = year === now.getUTCFullYear() ? now.getUTCMonth() : 11;
const months = MONTHS.map((name, m) => {
  const inMonth = dated.filter((e) => logDate(e.log.data).getUTCMonth() === m);
  const parts = kinds.map((k) => ({ ...k, n: count(inMonth, (e) => e.work.data.type === k.kind) }));
  return { month: m + 1, name, short: SHORT[m], total: inMonth.length, parts, future: m > lastMonth };
});
const maxMonth = Math.max(1, ...months.map((m) => m.total));
---
<section class="stats" aria-labelledby="stats-title">
  <h2 id="stats-title">En chiffres</h2>
  <div class="tiles">
    {tiles.map((t) => (
      <div class="tile" style={`--accent: var(--${t.kind})`}>
        <div class="head">
          <p class="value">{t.value}</p>
          <p class="label">{t.label}</p>
        </div>
        <div class="body">
          {(t.lines.filter((l) => l && l.length > 0) as string[][]).map((parts) => (
            <p class="meta parts">{parts.map((part, i) => <span class="part"><span class="sep">·</span>{i === 0 ? capitalize(part) : part}</span>)}</p>
          ))}
        </div>
      </div>
    ))}
    {ratings.length > 0 && (
      <div class="tile ratings" style="--accent: var(--ink)">
        <div class="head">
          <p class="value">{avg}<span class="unit">/5</span></p>
          <p class="label">note moyenne</p>
        </div>
        <div class="body">
          <p class="meta">Sur {plural(ratings.length, 'note', 'notes')}</p>
          <!-- Le cœur sert de légende : les coups de cœur forment le bas des barres, en couleur pleine. -->
          {likes > 0 && <p class="meta"><LikeIcon label="" />{plural(likes, ...LIKES)}</p>}
          <!-- Une barre par note ; le nombre est écrit au-dessus, la liste reste lisible sans les barres. -->
          <ol class="bars">
            {histogram.map(({ rating, n, liked }) => (
              <li title={`${plural(n, 'entrée notée', 'entrées notées')} ${rating}/5${liked ? `, dont ${plural(liked, ...LIKES)}` : ''}`}>
                <span class="count">{n}</span>
                <span class="bar" style={`--h: ${n / maxRating}; --liked: ${n ? liked / n : 0}`} />
                <span class="axis">{rating}<span aria-hidden="true">★</span><span class="visually-hidden">/5</span></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    )}
  </div>

  <figure class="timeline">
    <figcaption class="meta">
      Mois par mois<span class="sep">·</span>{kinds.map((k) => <span class="key" style={`--accent: var(--${k.kind})`}>{k.many}</span>)}
    </figcaption>
    <ol class="months">
      {months.map((m) => {
        const title = m.future ? undefined : `${capitalize(m.name)} : ${m.total ? m.parts.filter((p) => p.n).map((p) => plural(p.n, p.one, p.many)).join(', ') : 'rien'}`;
        const bar = <>
          <span class="count">{m.total > 0 && m.total}</span>
          {m.total > 0 && (
            <span class="stack" style={`--h: ${m.total / maxMonth}`}>
              {m.parts.filter((p) => p.n).map((p) => <span class="seg" style={`--n: ${p.n}; --accent: var(--${p.kind})`} />)}
            </span>
          )}
          <span class="axis"><span class="short" aria-hidden="true">{m.short}</span><span class="letter" aria-hidden="true">{m.name[0].toUpperCase()}</span><span class="visually-hidden">{m.name}</span></span>
        </>;
        // Un mois non vide est un bouton : il filtre le journal en dessous sur ce mois ; un second clic retire le filtre.
        return (
          <li class:list={{ future: m.future }} title={m.total > 0 ? undefined : title}>
            {m.total > 0 ? <button type="button" data-month={m.month} aria-pressed="false" title={title}>{bar}</button> : bar}
          </li>
        );
      })}
    </ol>
  </figure>
</section>

<script>
  // Filtre du journal par mois : les lignes de EntryList portent `data-month` (absent pour une date à l'année près).
  const buttons = document.querySelectorAll<HTMLButtonElement>('.months button[data-month]');
  const rows = document.querySelectorAll<HTMLElement>('.entries > li');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') !== 'true';
      for (const b of buttons) b.setAttribute('aria-pressed', String(on && b === button));
      for (const row of rows) row.hidden = on && row.dataset.month !== button.dataset.month;
    });
  }
</script>

<style>
  .stats { margin: 2rem 0 1rem; }
  .stats h2 { margin: 0 0 1rem; }
  /* 4 tuiles sur une ligne en grand écran, 2 × 2 à la largeur de lecture, une colonne sur téléphone. */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1rem; }
  .tile { margin: 0; padding: 0.9rem 1rem; border-radius: 6px; background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .tile p { margin: 0; }
  .value { font: 600 2.2rem/1 var(--sans); font-variant-numeric: tabular-nums; }
  .value .unit { font-size: 0.5em; font-weight: 500; color: var(--muted); }
  .tile .label { margin: 0.2rem 0 0.5rem; font: 600 0.95rem var(--sans); color: var(--accent); }
  .tile .meta + .meta { margin-top: 0.15rem; }
  /* Parties séparées par un point médian, chacune d'un bloc. Chaque partie porte son point devant elle ; la ligne est décalée
     de la largeur d'un point vers la gauche et rognée, pour que le point d'une partie en début de ligne (la première, ou
     celle renvoyée à la ligne) disparaisse : pas de point orphelin en fin ni en début de ligne. */
  .tile .parts { display: flex; flex-wrap: wrap; margin-left: -1.3em; clip-path: inset(0 0 0 1.3em); }
  .part { white-space: nowrap; }
  .parts .sep { display: inline-block; width: 1.3em; margin: 0; text-align: center; }

  .count { font: 600 0.75rem var(--sans); font-variant-numeric: tabular-nums; color: var(--muted); }
  .axis { width: 100%; padding-top: 0.25rem; border-top: 1px solid var(--line); text-align: center; font: 0.8rem var(--sans); color: var(--muted); }

  .bars { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 2px;
    align-items: end; height: 5rem; }
  .bars li, .months li { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
  /* Barre fine arrondie en haut, posée sur la ligne de base ; hauteur proportionnelle au nombre de notes.
     Les coups de cœur en forment le bas, en couleur pleine. */
  .bar { width: min(70%, 1.75rem); height: calc(var(--h) * 3rem); min-height: 2px; margin-top: 0.15rem; border-radius: 3px 3px 0 0;
    background: linear-gradient(to top, var(--ink) calc(var(--liked) * 100%), color-mix(in srgb, var(--ink) 40%, transparent) 0); }
  /* Cœur dans le texte : posé sur la ligne de base, à la hauteur des majuscules. */
  .ratings .meta :global(.like-icon) { display: inline-block; margin-right: 0.3em; vertical-align: -0.05em; transform: none; }
  .bars li:hover .bar { background: var(--ink); }

  .timeline { margin: 1.5rem 0 0; }
  .key::before { content: ''; display: inline-block; width: 0.6em; height: 0.6em; margin-right: 0.3em; border-radius: 50%; background: var(--accent); }
  .key + .key { margin-left: 0.75em; }
  .months { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2px;
    align-items: end; height: 8rem; }
  /* Une pile par mois, un segment par type d'œuvre (films en bas). */
  .stack { display: flex; flex-direction: column-reverse; gap: 1px; width: min(70%, 2.25rem); height: calc(var(--h) * 5.5rem); margin-top: 0.15rem;
    border-radius: 3px 3px 0 0; overflow: hidden; }
  .seg { flex: var(--n) 1 0; background: var(--accent); }
  .months button { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; width: 100%; height: 100%;
    padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
  .months button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 3px; }
  .months li:hover .stack { filter: brightness(1.15); }
  /* Mois sélectionné : les autres piles s'effacent, son libellé passe en gras. */
  .months:has([aria-pressed='true']) button:not([aria-pressed='true']) .stack { opacity: 0.35; }
  .months [aria-pressed='true'] .axis { color: var(--ink); font-weight: 600; border-top-color: var(--ink); }
  .months .future .axis { border-top-style: dashed; opacity: 0.6; }
  .letter { display: none; }

  @media (max-width: 34rem) {
    /* Téléphone : chiffre à gauche, détails à droite, pour que les tuiles ne prennent pas tout l'écran. */
    .tiles { gap: 0.6rem; }
    .tile { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0 0.75rem; align-items: center; }
    .tile .label { margin-bottom: 0; }
    .months { height: 7rem; }
    .stack { height: calc(var(--h) * 4.5rem); }
    .short { display: none; }
    .letter { display: inline; }
  }
</style>
