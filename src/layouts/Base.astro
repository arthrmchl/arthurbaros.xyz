---
import { href } from '../lib/content';
// `shareTitle` et `image` : aperçu affiché lors du partage d'un lien (Open Graph).
interface Props { title?: string; description?: string; shareTitle?: string; image?: string; article?: boolean }
const { title, description = 'Mes avis sur les films que je vois et les livres que je lis.', shareTitle, image, article = false } = Astro.props;
const siteName = 'Journal de bord';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
// Les aperçus exigent des URL absolues : une image dans /public devient relative au site.
const imageUrl = image && new URL(image.startsWith('/') ? href(image) : image, Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={shareTitle ?? title ?? siteName} />
    <meta property="og:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={href('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={href('/')}>{siteName}</a>
      <nav aria-label="Navigation principale">
        <a href={href('/films/')}>Films</a>
        <a href={href('/livres/')}>Livres</a>
        <a href={href('/a-propos/')}>À propos</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <a href={href('/rss.xml')}>Flux RSS</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #eef1ec; --ink: #17232b; --muted: #55646e; --line: #c9d1cb;
    --film: #1d5c78; --livre: #66661c;
    --serif: 'Newsreader', Georgia, serif; --sans: 'Instrument Sans', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --paper: #12191e; --ink: #e6ebe7; --muted: #94a3ad; --line: #2b3841; --film: #7cc0dd; --livre: #c6c66a; }
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); }
  body { margin: 0 auto; max-width: 42rem; padding: 0 1.25rem; font: 1.15rem/1.65 var(--serif); }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  a:focus-visible { outline: 2px solid var(--film); outline-offset: 3px; }
  h1, h2, h3 { line-height: 1.2; font-weight: 600; }
  h1 { font-size: 2.1rem; margin: 2.5rem 0 0.4rem; }
  h2 { font-size: 1.35rem; margin: 2.5rem 0 0.5rem; }
  .site-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap;
    padding: 1.5rem 0 1rem; border-bottom: 1px solid var(--line); font-family: var(--sans); }
  .brand { font-weight: 600; text-decoration: none; font-size: 1.05rem; }
  .site-header nav { display: flex; gap: 1.25rem; font-size: 0.95rem; }
  .site-footer { margin: 4rem 0 2rem; padding-top: 1rem; border-top: 1px solid var(--line); font: 0.9rem var(--sans); color: var(--muted); }
  .meta { font: 0.9rem/1.4 var(--sans); color: var(--muted); }
  .kind-film { color: var(--film); } .kind-livre { color: var(--livre); }
  .entries { list-style: none; padding: 0; margin: 1.5rem 0; }
  .entries li { display: grid; grid-template-columns: 7.5rem 1fr auto; gap: 0.25rem 1.25rem; align-items: baseline;
    padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .entries .date { font: 0.9rem var(--sans); color: var(--muted); }
  .entries .name { font-weight: 600; }
  .entries .summary { grid-column: 2 / 4; margin: 0; color: var(--muted); font-size: 1rem; }
  .rating { font: 600 0.95rem var(--sans); white-space: nowrap; }
  .notice { font: 0.95rem var(--sans); padding: 0.6rem 0.9rem; border-left: 3px solid var(--livre); background: color-mix(in srgb, var(--livre) 10%, transparent); }
  .prose img { max-width: 100%; height: auto; }
  .prose blockquote { margin-left: 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--muted); }
  .cover { float: right; width: 8rem; margin: 0 0 1rem 1.5rem; }
  .backdrop { display: block; width: 100%; aspect-ratio: 21 / 9; object-fit: cover; margin: 0 0 1.5rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; list-style: none; font: 0.85rem var(--sans); color: var(--muted); }

  /* Mise en page commune aux fiches d'œuvre et aux reviews (à la Letterboxd). */
  /* Image de fond large qui se fond dans la page (bas et côtés). */
  body:has(.hero) { overflow-x: clip; }
  .hero { width: min(100vw, 72rem); margin-left: calc(50% - min(50vw, 36rem)); }
  /* Hauteur plafonnée pour que le texte reste visible sans défiler. */
  .hero img { display: block; width: 100%; aspect-ratio: 21 / 9; max-height: min(22rem, 40vh); object-fit: cover; object-position: center 30%;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent), linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, #000 55%, transparent), linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-composite: intersect; }
  /* Affiche à gauche, informations à droite. */
  .sheet { display: grid; grid-template-columns: 9rem 1fr; gap: 0 2rem; align-items: start; margin-top: 2.5rem; position: relative; }
  .sheet.has-hero { margin-top: -5rem; }
  .sheet:not(:has(.side)) { grid-template-columns: 1fr; }
  .sheet .poster { display: block; width: 100%; border-radius: 4px; box-shadow: 0 0 0 1px var(--line), 0 8px 24px rgb(0 0 0 / 0.25); }
  .sheet .side .meta { margin: 0.75rem 0 0; text-align: center; }
  /* Sur l'image de fond, le titre descend au niveau du bas de l'affiche. */
  .sheet.has-hero .info { padding-top: 4rem; }
  .sheet .prose > :first-child { margin-top: 0.75rem; }
  .sheet h1 { margin: 0; }
  .sheet header .meta { margin: 0.25rem 0 0; }
  /* Titre et sous-titre sur la même ligne (passe à la ligne si trop long). */
  .title-line { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.75rem; }
  .original-title { font-size: 1.15rem; font-style: italic; color: var(--muted); }
  /* Informations secondaires sur une ligne, sous le texte. */
  .details { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem; margin: 1.25rem 0 0;
    padding-top: 1rem; border-top: 1px solid var(--line); }
  .details > * { margin: 0; }
  .stars { color: var(--film); letter-spacing: 0.08em; white-space: nowrap; }
  .stars.is-livre { color: var(--livre); }

  /* Sur grand écran, colonne plus large pour réduire les marges latérales. */
  @media (min-width: 64rem) {
    body { max-width: 64rem; }
  }

  @media (max-width: 34rem) {
    .sheet { grid-template-columns: 7rem 1fr; gap: 0 1.25rem; }
    .sheet.has-hero { margin-top: -3rem; }
    .sheet.has-hero .info { padding-top: 2.5rem; }
    .entries li { grid-template-columns: 1fr auto; }
    .entries .date, .entries .summary { grid-column: 1 / 3; }
  }
</style>
