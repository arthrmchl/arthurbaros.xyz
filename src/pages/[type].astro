---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import { getJournal, inProgress, todoLabel } from '../lib/content';

export function getStaticPaths() {
  return [
    { params: { type: 'films' }, props: { kind: 'film', title: 'Films' } },
    { params: { type: 'livres' }, props: { kind: 'livre', title: 'Livres' } },
    { params: { type: 'series' }, props: { kind: 'serie', title: 'Séries' } },
  ] as const;
}
const { kind, title } = Astro.props;
const entries = (await getJournal()).filter(({ work }) => work.data.type === kind);
// Une seule fois par œuvre, de la plus récente à la plus ancienne (le journal est déjà trié).
// Pour un livre ou une série, l'entrée la plus récente dit s'il est en cours de lecture ou de visionnage.
const seen = new Set<string>();
const works = entries
  .filter(({ work }) => !seen.has(work.id) && seen.add(work.id))
  .map(({ log, work }) => ({ work, reading: inProgress(log.data) }));
// Fiches sans aucune entrée de journal : œuvres à lire / à voir, par ordre alphabétique.
const todo = (await getCollection('works'))
  .filter((w) => w.data.type === kind && !seen.has(w.id))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));
const reading = works.filter((w) => w.reading).length;
const done = works.length - reading;
const noun = { film: ['film', 'films'], livre: ['livre', 'livres'], serie: ['série', 'séries'] }[kind];
const plural = (n: number) => noun[n > 1 ? 1 : 0];
const participle = { film: ['vu', 'vus'], livre: ['lu', 'lus'], serie: ['vue', 'vues'] }[kind];
const counts = [done && `${done} ${plural(done)} ${participle[done > 1 ? 1 : 0]}`, reading && `${reading} en cours`].filter(Boolean);
const count = counts.join(' · ') || `0 ${noun[0]} ${participle[0]}`;
const intro = { film: 'Les films que j’ai vus', livre: 'Les livres que j’ai lus', serie: 'Les séries que j’ai regardées' }[kind];
---
<Base title={title} description={`${intro}, avec mes notes et mes avis : ${count}.`}>
  <h1>{title}</h1>
  <p class="meta">{counts.length ? counts.map((c, i) => <>{i > 0 && <span class="sep">·</span>}{c}</>) : count}</p>
  <ul class="posters" style={`--accent: var(--${kind})`}>
    {works.map(({ work, reading }) => <Poster work={work} badge={reading ? 'En cours' : undefined} />)}
  </ul>
  {todo.length > 0 && (
    <>
      <h2>{todoLabel[kind]}</h2>
      <p class="meta">{todo.length} {plural(todo.length)}</p>
      <ul class="posters" style={`--accent: var(--${kind})`}>
        {todo.map((work) => <Poster work={work} />)}
      </ul>
    </>
  )}
</Base>

<style>
  .posters { list-style: none; padding: 0; margin: 1.5rem 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr)); gap: 1rem; align-items: end; }
  @media (max-width: 34rem) {
    .posters { grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  }
</style>
