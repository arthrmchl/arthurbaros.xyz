---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { byRelease, getJournal, inProgress, latestByWork, pageSize, pageSuffix, paginate, todoLabel } from '../../lib/content';

// Œuvres vues ou lues puis œuvres à voir / à lire, à la suite, par pages : la section « À voir » commence sur la page où elle tombe.
export async function getStaticPaths() {
  const [journal, all] = await Promise.all([getJournal(), getCollection('works')]);
  return ([
    { type: 'films', kind: 'film', title: 'Films' },
    { type: 'livres', kind: 'livre', title: 'Livres' },
    { type: 'series', kind: 'serie', title: 'Séries' },
  ] as const).flatMap(({ type, kind, title }) => {
    // Une seule fois par œuvre, de la sortie la plus récente à la plus ancienne.
    // Pour un livre ou une série, l'entrée la plus récente dit s'il est en cours de lecture ou de visionnage.
    const works = latestByWork(journal.filter(({ work }) => work.data.type === kind))
      .map(({ log, work }) => ({ work, reading: inProgress(log.data), todo: false }))
      .sort((a, b) => byRelease(a.work, b.work));
    const seen = new Set(works.map(({ work }) => work.id));
    // Fiches sans aucune entrée de journal : œuvres à lire / à voir, elles aussi par date de sortie.
    const todo = all
      .filter((w) => w.data.type === kind && !seen.has(w.id))
      .sort(byRelease)
      .map((work) => ({ work, reading: false, todo: true }));
    const reading = works.filter((w) => w.reading).length;
    return paginate([...works, ...todo], pageSize.works).map(({ page, ...props }) => ({
      params: { type, page },
      props: { ...props, kind, title, done: works.length - reading, reading, todoCount: todo.length },
    }));
  });
}
const { kind, title, items, current, last, done, reading, todoCount } = Astro.props;
const works = items.filter((i) => !i.todo);
const todo = items.filter((i) => i.todo);
const noun = { film: ['film', 'films'], livre: ['livre', 'livres'], serie: ['série', 'séries'] }[kind];
const plural = (n: number) => noun[n > 1 ? 1 : 0];
const participle = { film: ['vu', 'vus'], livre: ['lu', 'lus'], serie: ['vue', 'vues'] }[kind];
const counts = [done && `${done} ${plural(done)} ${participle[done > 1 ? 1 : 0]}`, reading && `${reading} en cours`].filter(Boolean);
const count = counts.join(' · ') || `0 ${noun[0]} ${participle[0]}`;
const intro = { film: 'Les films que j’ai vus', livre: 'Les livres que j’ai lus', serie: 'Les séries que j’ai regardées' }[kind];
const suffix = pageSuffix(current, last);
---
<Base title={`${title}${suffix}`} description={`${intro}, avec mes notes et mes avis : ${count}${suffix}.`}>
  <h1>{title}</h1>
  <p class="meta">{counts.length ? counts.map((c, i) => <>{i > 0 && <span class="sep">·</span>}{c}</>) : count}</p>
  {works.length > 0 && <WorkGrid items={works.map(({ work, reading }) => ({ work, badge: reading ? 'En cours' : undefined }))} />}
  {todo.length > 0 && (
    <>
      <h2>{todoLabel[kind]}</h2>
      <p class="meta">{todoCount} {plural(todoCount)}</p>
      <WorkGrid items={todo.map(({ work }) => ({ work }))} />
    </>
  )}
  <Pagination current={current} last={last} root={`/${Astro.params.type}/`} />
</Base>

