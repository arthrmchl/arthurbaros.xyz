---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import YearStats from '../../components/YearStats.astro';
import { getJournal, journalYears, logDate, episodeTotals, statsSummary, href } from '../../lib/content';

export async function getStaticPaths() {
  const journal = await getJournal();
  return journalYears(journal).map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      entries: journal.filter(({ log }) => logDate(log.data).getUTCFullYear() === year),
      ...episodeTotals(journal, year),
    },
  }));
}
const { year, entries, episodes, episodeMinutes } = Astro.props;
---
<Base title={`Bilan ${year} : reviews et critiques de l’année`} description={`Bilan ${year} : ${statsSummary(entries)}`}>
  <h1>{year}</h1>
  <p class="meta"><a href={href('/annees/')}>Toutes années confondues →</a></p>
  <YearStats year={year} entries={entries} episodes={episodes} episodeMinutes={episodeMinutes} />
  <h2>Journal</h2>
  <EntryList entries={entries} />
</Base>
