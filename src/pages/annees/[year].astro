---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getJournal } from '../../lib/content';

export async function getStaticPaths() {
  const journal = await getJournal();
  const years = [...new Set(journal.map(({ log }) => log.data.date.getUTCFullYear()))];
  return years.map((year) => ({
    params: { year: String(year) },
    props: { year, entries: journal.filter(({ log }) => log.data.date.getUTCFullYear() === year) },
  }));
}
const { year, entries } = Astro.props;
const films = entries.filter((e) => e.work.data.type === 'film').length;
const livres = entries.filter((e) => e.work.data.type === 'livre').length;
const avg = entries.reduce((s, e) => s + e.log.data.rating, 0) / entries.length;
---
<Base title={`Bilan ${year}`}>
  <h1>{year}</h1>
  <p class="meta">
    {films} {films > 1 ? 'films' : 'film'}, {livres} {livres > 1 ? 'livres' : 'livre'}.
    Note moyenne : {avg.toFixed(1).replace('.', ',')}/5.
  </p>
  <EntryList entries={entries} />
</Base>
