---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getJournal, href, slugify, workItems } from '../../lib/content';
import { genres } from '../../lib/genres';

// Une page par genre utilisé dans au moins une fiche.
export async function getStaticPaths() {
  const works = await getCollection('works');
  return genres
    .map((genre) => ({ genre, works: works.filter((w) => (w.data.tags as string[]).includes(genre)) }))
    .filter(({ works }) => works.length > 0)
    .map(({ genre, works }) => ({ params: { genre: slugify(genre) }, props: { genre, works } }));
}
const { genre, works } = Astro.props as { genre: string; works: CollectionEntry<'works'>[] };
const items = workItems(works, await getJournal());
const count = `${works.length} ${works.length > 1 ? 'œuvres' : 'œuvre'}`;
---
<Base title={`Genre : ${genre}`} description={`Films, livres et séries du genre ${genre}, avec mes notes : ${count}.`}>
  <p class="meta"><a href={href('/genres/')}>Genres</a></p>
  <h1 class="genre">{genre}</h1>
  <p class="meta">{count}</p>
  <WorkGrid items={items} />
</Base>

<style>
  .genre { margin-top: 0.5rem; }
  .genre::first-letter { text-transform: uppercase; }
</style>
