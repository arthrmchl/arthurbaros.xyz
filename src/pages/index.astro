---
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import RepeatIcon from '../components/RepeatIcon.astro';
import ReviewIcon from '../components/ReviewIcon.astro';
import { getJournal, href, logDate, fmtDate, fmtShortDate, fmtStars, fmtYears, inProgress, repeatLabel, seasonLabel } from '../lib/content';

const journal = await getJournal();
const years = [...new Set(journal.map(({ log }) => logDate(log.data).getUTCFullYear()))].sort((a, b) => b - a);

// Lectures et saisons en cours : la plus récente entrée de chaque livre ou série, si elle n'a pas de date de fin.
const seen = new Set<string>();
const reading = journal
  .filter(({ work }) => work.data.type !== 'film' && !seen.has(work.id) && seen.add(work.id))
  .filter(({ log }) => inProgress(log.data));
// Derniers passages terminés, une rangée par type. Les séries, plus rares, n'ont leur rangée qu'une fois la première vue.
const recent = (kind: 'film' | 'livre' | 'serie') =>
  journal.filter(({ log, work }) => work.data.type === kind && !inProgress(log.data)).slice(0, 5);
const shelves = ([
  { kind: 'film', title: 'Derniers films vus', all: 'Tous les films', route: '/films/', entries: recent('film') },
  { kind: 'livre', title: 'Derniers livres lus', all: 'Tous les livres', route: '/livres/', entries: recent('livre') },
  { kind: 'serie', title: 'Dernières séries vues', all: 'Toutes les séries', route: '/series/', entries: recent('serie') },
] as const).filter(({ kind, entries }) => kind !== 'serie' || entries.length);
---
<Base>
  {reading.length > 0 && <div class="now">{reading.map(({ log, work, season }) => (
    <a class="reading" href={href(`/journal/${log.id}/`)} style={`--accent: var(--${work.data.type})`}>
      {(season?.poster ?? work.data.poster ?? work.data.cover) && <img src={season?.poster ?? work.data.poster ?? work.data.cover} alt="" />}
      <div>
        <p class="meta">
          {season ? 'En train de regarder' : 'En train de lire'}
          {log.data.started && <> depuis le {fmtDate(log.data.started)}</>}
        </p>
        <p class="title">{work.data.title}</p>
        {season
          ? <p class="meta">{seasonLabel(season)}<span class="sep">·</span>{season.seen.size}/{season.episodes} épisodes</p>
          : <p class="meta">{work.data.creator}, {fmtYears(work.data)}</p>}
        {log.data.summary && <p class="summary">{log.data.summary}</p>}
      </div>
    </a>
  ))}</div>}

  {shelves.map(({ kind, title, all, route, entries }) => (
    <section>
      <div class="shelf-head">
        <h2>{title}</h2>
        <a class="meta" href={href(route)}>{all} →</a>
      </div>
      {entries.length
        ? <ul class="posters" style={`--accent: var(--${kind})`}>
            {entries.map(({ log, work, season }) => (
              <Poster work={work} link={`/journal/${log.id}/`} image={season?.poster}>
                <span class="rated">
                  {log.data.rating !== undefined && <span class={`stars is-${kind}`}>{fmtStars(log.data.rating)}</span>}
                  {log.data.repeat && <RepeatIcon label={repeatLabel[kind]} />}
                  {log.body?.trim() && <ReviewIcon />}
                </span>{season && <>S{season.number} · </>}{fmtShortDate(log.data.date!)}
              </Poster>
            ))}
          </ul>
        : <p class="meta">Rien pour l'instant.</p>}
    </section>
  ))}

  <p class="meta">
    Bilans par année :
    {years.map((y, i) => <>{i > 0 && ', '}<a href={href(`/annees/${y}/`)}>{y}</a></>)}
  </p>
</Base>

<style>
  /* Œuvres en cours côte à côte quand la colonne est assez large, sinon empilées. */
  .now { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: 1rem; margin: 2rem 0 0; }
  /* Lecture en cours : grande couverture et fond teinté. */
  .reading { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1.25rem; align-items: center;
    padding: 1rem; border-radius: 6px; text-decoration: none; background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .reading:hover .title { text-decoration: underline; }
  .reading img { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px var(--line), 0 4px 12px rgb(0 0 0 / 0.2); }
  .reading p { margin: 0; }
  .reading .meta:first-child { color: var(--accent); font-weight: 600; }
  .reading .title { font-size: 1.5rem; font-weight: 600; line-height: 1.2; margin: 0.3rem 0 0.2rem; }
  .reading .sep { margin: 0 0.4em; }
  .reading .summary { margin-top: 0.5rem; font-size: 1rem; color: var(--muted); }
  .shelf-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .shelf-head a { text-decoration: none; }
  .shelf-head a:hover { text-decoration: underline; }
  /* Une rangée de 5 ; les images s'alignent par le bas au-dessus des légendes. */
  .posters { list-style: none; padding: 0; margin: 1rem 0 0; display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; align-items: end; }
  /* Étoiles puis icônes de revisionnage et de review sur une même ligne, comme sous les affiches de Letterboxd. */
  .rated { display: flex; align-items: center; gap: 0.35rem; }
  .rated :global(.repeat-icon), .rated :global(.review-icon) { width: 0.95rem; height: 0.95rem; }
  section + p.meta { margin-top: 2.5rem; }
  @media (max-width: 34rem) {
    .reading { grid-template-columns: 5rem 1fr; gap: 1rem; }
    .reading .title { font-size: 1.25rem; }
    .posters { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.6rem; }
    .posters > :global(li:nth-child(n + 4)) { display: none; }
  }
</style>
