---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import Pagination from '../../components/Pagination.astro';
import { getJournal, journalYears, href, logDate, pageSize, pageSuffix, paginate, type JournalEntry } from '../../lib/content';

// Toutes les entrées, de la plus récente à la plus ancienne, par pages ; sur chaque page, regroupées par année avec un lien vers le bilan.
export async function getStaticPaths() {
  const journal = await getJournal();
  return paginate(journal, pageSize.journal).map(({ page, ...props }) => ({ params: { page }, props: { ...props, total: journal.length } }));
}
const { items, current, last, total } = Astro.props as { items: JournalEntry[]; current: number; last: number; total: number };
const years = journalYears(items).map((year) => ({ year, entries: items.filter(({ log }) => logDate(log.data).getUTCFullYear() === year) }));
const count = `${total} ${total > 1 ? 'entrées' : 'entrée'}`;
const suffix = pageSuffix(current, last);
---
<Base title={`Journal${suffix}`} description={`Tous mes visionnages et lectures, du plus récent au plus ancien : ${count}${suffix}.`}>
  <h1>Journal</h1>
  <p class="meta">{count}</p>
  {years.map(({ year, entries }) => (
    <section>
      <div class="year-head">
        <h2>{year}</h2>
        <a class="meta" href={href(`/annees/${year}/`)}>Bilan {year} →</a>
      </div>
      <EntryList entries={entries} />
    </section>
  ))}
  <Pagination current={current} last={last} root="/journal/" />
</Base>

<style>
  .year-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .year-head a { text-decoration: none; }
  .year-head a:hover { text-decoration: underline; }
</style>
