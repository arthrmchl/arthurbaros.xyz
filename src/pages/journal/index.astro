---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getJournal, href, logDate } from '../../lib/content';

// Toutes les entrées, de la plus récente à la plus ancienne, regroupées par année avec un lien vers le bilan.
const journal = await getJournal();
const years = [...new Set(journal.map(({ log }) => logDate(log.data).getUTCFullYear()))].sort((a, b) => b - a)
  .map((year) => ({ year, entries: journal.filter(({ log }) => logDate(log.data).getUTCFullYear() === year) }));
const count = `${journal.length} ${journal.length > 1 ? 'entrées' : 'entrée'}`;
---
<Base title="Journal" description={`Tous mes visionnages et lectures, du plus récent au plus ancien : ${count}.`}>
  <h1>Journal</h1>
  <p class="meta">{count}</p>
  {years.map(({ year, entries }) => (
    <section>
      <div class="year-head">
        <h2>{year}</h2>
        <a class="meta" href={href(`/annees/${year}/`)}>Bilan {year} →</a>
      </div>
      <EntryList entries={entries} />
    </section>
  ))}
</Base>

<style>
  .year-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .year-head a { text-decoration: none; }
  .year-head a:hover { text-decoration: underline; }
</style>
