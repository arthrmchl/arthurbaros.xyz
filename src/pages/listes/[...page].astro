---
import Base from '../../layouts/Base.astro';
import Pagination from '../../components/Pagination.astro';
import { excerpt, fmtListCount, getJournal, getLists, href, listTypeLabel, pageSize, pageSuffix, paginate, posterImage, type ListEntry } from '../../lib/content';

// Toutes les listes, la plus récemment mise à jour d'abord, par pages, avec un aperçu de leurs premières affiches.
export async function getStaticPaths() {
  const lists = await getLists(await getJournal());
  return paginate(lists, pageSize.lists).map(({ page, ...props }) => ({ params: { page }, props: { ...props, total: lists.length } }));
}
const { items: lists, current, last, total } = Astro.props as { items: ListEntry[]; current: number; last: number; total: number };
// Le filtre agit sur la page affichée : seuls les médias qui y figurent ont un bouton.
const kinds = (['film', 'livre', 'serie', 'mixte'] as const).filter((k) => lists.some(({ list }) => (list.data.type ?? 'mixte') === k));
const count = `${total} ${total > 1 ? 'listes' : 'liste'}`;
const suffix = pageSuffix(current, last);
---
<Base title={`Listes${suffix}`} description={`Mes listes de films, de livres et de séries : ${lists.map(({ list }) => list.data.title).join(', ') || 'aucune pour l’instant'}${suffix}.`}>
  <h1>Listes</h1>
  <p class="meta">{total ? count : 'Aucune liste pour l’instant.'}</p>

  {kinds.length > 1 && (
    <div class="filters" role="group" aria-label="Filtrer par média">
      {kinds.map((k) => <button type="button" class:list={['pill', `is-${k}`]} data-kind={k} aria-pressed="false">{listTypeLabel[k]}</button>)}
    </div>
  )}

  <ul class="lists">
    {lists.map(({ list, items }) => {
      const l = list.data;
      const kind = l.type ?? 'mixte';
      return (
        <li data-kind={kind}>
          <a class="card" href={href(`/listes/${list.id}/`)}>
            <span class="stack" aria-hidden="true">
              {items.slice(0, 5).map(({ work, image }) => (
                <span class="cover" style={`--accent: var(--${work.data.type})`}>
                  {image ? <img {...posterImage(image, '5rem')} alt="" loading="lazy" /> : <span class="placeholder" />}
                </span>
              ))}
            </span>
            <span class="text">
              <span class="title">{l.title}</span>
              <span class="meta">
                <span class:list={['pill', `is-${kind}`]}>{listTypeLabel[kind]}</span>
                <span class="sep">·</span>{l.ranked ? `Classement, ${fmtListCount(items.length, l.type)}` : fmtListCount(items.length, l.type)}
              </span>
              {list.body?.trim() && <span class="excerpt">{excerpt(list.body, 160)}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  <Pagination current={current} last={last} root="/listes/" />
</Base>

<script>
  // Filtre par média : un bouton par type présent ; un second clic retire le filtre.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button[data-kind]');
  const cards = document.querySelectorAll<HTMLElement>('.lists > li');
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') !== 'true';
      for (const b of buttons) b.setAttribute('aria-pressed', String(on && b === button));
      for (const card of cards) card.hidden = on && card.dataset.kind !== button.dataset.kind;
    });
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; }
  .filters button { border: none; cursor: pointer; opacity: 0.55; }
  .filters button:hover, .filters [aria-pressed='true'] { opacity: 1; }
  .filters:not(:has([aria-pressed='true'])) button { opacity: 1; }
  .filters [aria-pressed='true'] { box-shadow: inset 0 0 0 1.5px currentColor; }
  .filters button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .lists { list-style: none; padding: 0; margin: 1.5rem 0; }
  .lists > li { border-bottom: 1px solid var(--line); }
  .card { display: grid; grid-template-columns: 13rem 1fr; gap: 1.5rem; align-items: center; padding: 1.25rem 0; text-decoration: none; }
  /* Affiches qui se chevauchent, la première au-dessus (à la Letterboxd). */
  .stack { display: flex; }
  .cover { position: relative; flex: none; width: 4.5rem; border-radius: 4px; overflow: hidden;
    box-shadow: 0 0 0 1px var(--line), 2px 0 8px rgb(0 0 0 / 0.3); }
  .cover + .cover { margin-left: -2.4rem; }
  .cover:nth-child(1) { z-index: 5; } .cover:nth-child(2) { z-index: 4; } .cover:nth-child(3) { z-index: 3; }
  .cover:nth-child(4) { z-index: 2; } .cover:nth-child(5) { z-index: 1; }
  .cover img, .placeholder { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; }
  .placeholder { background: color-mix(in srgb, var(--accent) 25%, var(--paper)); }
  .text { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .title { font: 600 1.3rem/1.25 var(--serif); }
  .card:hover .title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .excerpt { font-size: 1rem; line-height: 1.5; color: var(--muted); }

  @media (max-width: 34rem) {
    .card { grid-template-columns: 1fr; gap: 0.75rem; }
    .cover { width: 4rem; }
    .cover + .cover { margin-left: -2rem; }
  }
</style>
