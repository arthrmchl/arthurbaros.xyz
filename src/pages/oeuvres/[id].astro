---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RepeatIcon from '../../components/RepeatIcon.astro';
import ReviewIcon from '../../components/ReviewIcon.astro';
import { getJournal, excerpt, shareImage, fmtRuntime, href, fmtAired, fmtReleased, fmtDate, fmtShortDate, fmtRating, fmtStars, fmtRange, fmtYears, capitalize, seasonLabel, venueLabel, versionLabel, todoLabel, typeLabel, typeRoute } from '../../lib/content';

export async function getStaticPaths() {
  const [works, journal] = await Promise.all([getCollection('works'), getJournal()]);
  return works.map((work) => ({
    params: { id: work.id },
    props: { work, entries: journal.filter((e) => e.work.id === work.id) },
  }));
}
const { work, entries } = Astro.props;
const { Content } = await render(work);
const w = work.data;
const years = fmtYears(w);
const released = fmtReleased(w);
const description = excerpt(work.body) || `${typeLabel[w.type]} de ${w.creator} (${years}) : fiche et ${w.type === 'livre' ? 'lectures' : 'visionnages'}.`;

// Séries : pour chaque saison, ses entrées de journal (la plus récente d'abord) et la date
// du dernier visionnage de chaque épisode, tous passages confondus.
const seasons = w.seasons.map((s) => {
  const logs = entries.filter((e) => e.season?.number === s.number);
  const seen = new Map<number, Date>();
  for (const e of logs) for (const [n, d] of e.season!.seen) if (!seen.has(n)) seen.set(n, d);
  return { ...s, logs, seen, aired: fmtAired(s), ongoing: logs.some((e) => !e.log.data.date) };
});
const episodeCount = w.seasons.reduce((n, s) => n + s.episodes, 0);
const seriesReviews = entries.filter((e) => w.type === 'serie' && !e.season);
---
<Base title={`${w.title} (${years}), ${w.creator}`} description={description}
  image={shareImage(w.backdrop) ?? w.poster ?? w.cover} imageAlt={w.backdrop ? `Image ${w.type === 'film' ? 'du film' : 'de la série'} ${w.title}` : `${w.poster ? 'Affiche' : 'Couverture'} : ${w.title}`} largeImage={Boolean(w.backdrop)}>
  {w.backdrop && <div class="hero"><img src={w.backdrop} alt="" /></div>}

  <!-- Structure à la Letterboxd : affiche à gauche, informations à droite. -->
  <article class:list={['sheet', { 'has-hero': w.backdrop }]}>
    {(w.poster || w.cover) && (
      <aside class="side">
        {w.poster && <img class="poster" src={w.poster} alt={`Affiche : ${w.title}`} />}
        {w.cover && <img class="poster" src={w.cover} alt={`Couverture : ${w.title}`} />}
      </aside>
    )}

    <div class="info">
      <header class="title-line">
        <h1>{w.title}</h1>
        {w.originalTitle && <span class="original-title">{w.originalTitle}</span>}
        <span class="meta">{w.creator}&nbsp;– {years}</span>
      </header>
      <div class="prose"><Content /></div>
      {(w.runtime || released || w.originalLanguage || w.seasons.length > 0 || w.firstAired || w.tags.length > 0) && (
        <div class="details">
          {w.runtime && <p class="meta">{fmtRuntime(w.runtime)}</p>}
          {w.seasons.length > 0 && <p class="meta">{w.seasons.length} {w.seasons.length > 1 ? 'saisons' : 'saison'}<span class="sep">·</span>{episodeCount} {episodeCount > 1 ? 'épisodes' : 'épisode'}</p>}
          {w.firstAired && <p class="meta">{fmtAired(w)}</p>}
          {released && <p class="meta">{released}</p>}
          {w.originalLanguage && <p class="meta">Langue originale : {capitalize(w.originalLanguage)}</p>}
          {w.tags.length > 0 && <ul class="tags">{w.tags.map((t) => <li class={`pill is-${w.type}`}>{t.toLowerCase()}</li>)}</ul>}
        </div>
      )}
    </div>
  </article>

  {w.type === 'serie' && (
    <>
      {entries.length === 0 && <p class="notice">Pas encore commencée : dans ma liste <a href={href('/series/')}>à voir</a>.</p>}
      {seasons.length > 0 && <h2>Saisons</h2>}
      {seasons.map((s) => {
        const last = s.logs.find((e) => e.log.data.rating !== undefined)?.log.data.rating;
        return (
          <details class="season" open={s.ongoing || seasons.length === 1}>
            <summary>
              <span class="season-name">{seasonLabel(s)}</span>
              <span class="meta">{s.firstAired?.getUTCFullYear()}</span>
              <span class="meta progress">{s.seen.size > 0 ? `${s.seen.size}/${s.episodes}` : `${s.episodes} ép.`}</span>
              {last !== undefined
                ? <span class="stars is-serie" aria-label={`Note : ${fmtRating(last)}`} title={fmtRating(last)}>{last > 0 ? fmtStars(last) : '—'}</span>
                : <span />}
            </summary>
            <div class="season-body">
              {s.poster && <img class="season-poster" src={s.poster} alt={`Affiche : ${w.title}, ${seasonLabel(s).toLowerCase()}`} loading="lazy" />}
              <div>
                {s.aired && <p class="meta">{s.aired}</p>}
                <ol class="episodes">
                  {Array.from({ length: s.episodes }, (_, i) => i + 1).map((n) => (
                    <li class:list={{ seen: s.seen.has(n) }}>
                      <span class="num">{n}</span>
                      <span class="ep-title">{s.titles[n - 1] ?? `Épisode ${n}`}</span>
                      {s.seen.has(n)
                        ? <time class="meta" datetime={s.seen.get(n)!.toISOString().slice(0, 10)} title={`Vu le ${fmtDate(s.seen.get(n)!)}`}>{fmtShortDate(s.seen.get(n)!)}</time>
                        : <span />}
                    </li>
                  ))}
                </ol>
                {s.logs.length > 0 && (
                  <ul class="viewings readings">
                    {s.logs.map(({ log, season }) => (
                      <li>
                        <a class="date" href={href(`/journal/${log.id}/`)}>
                          {log.data.started && log.data.date
                            ? (log.data.started.getTime() === log.data.date.getTime() ? `Le ${fmtDate(log.data.date)}` : capitalize(fmtRange(log.data.started, log.data.date)))
                            : log.data.started ? `Depuis le ${fmtDate(log.data.started)}`
                            : fmtDate(log.data.date!)}
                        </a>
                        {log.data.rating !== undefined
                          ? <span class="stars is-serie" aria-label={`Note : ${fmtRating(log.data.rating)}`} title={fmtRating(log.data.rating)}>
                              {log.data.rating > 0 ? fmtStars(log.data.rating) : '—'}
                            </span>
                          : <span class="meta">{!log.data.date ? <>En cours<span class="sep">·</span>{season!.seen.size}/{season!.episodes}</> : season!.complete ? '—' : 'Abandonnée'}</span>}
                        <span class="meta extra">{log.data.version ? versionLabel[log.data.version] : '—'}</span>
                        <span class="repeat">{log.data.repeat && <RepeatIcon label="Revisionnage" />}</span>
                        <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </details>
        );
      })}
      {seriesReviews.length > 0 && (
        <>
          <h2>Mes avis sur la série</h2>
          <ul class="viewings readings">
            {seriesReviews.map(({ log }) => (
              <li>
                <a class="date" href={href(`/journal/${log.id}/`)}>
                  <time datetime={log.data.date!.toISOString().slice(0, 10)}>{fmtDate(log.data.date!)}</time>
                </a>
                {log.data.rating !== undefined
                  ? <span class="stars is-serie" aria-label={`Note : ${fmtRating(log.data.rating)}`} title={fmtRating(log.data.rating)}>
                      {log.data.rating > 0 ? fmtStars(log.data.rating) : '—'}
                    </span>
                  : <span class="meta">—</span>}
                <span class="meta extra" />
                <span class="repeat">{log.data.repeat && <RepeatIcon label="Revisionnage" />}</span>
                <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  )}

  {w.type === 'serie' ? null
    : entries.length === 0
    ? <p class="notice">Pas encore {w.type === 'film' ? 'vu' : 'commencé'} : dans ma liste <a href={href(`/${typeRoute[w.type]}/`)}>{todoLabel[w.type].toLowerCase()}</a>.</p>
    : w.type === 'film'
    ? <>
        <h2>Mes visionnages</h2>
        <ul class="viewings">
          {entries.map(({ log }) => (
            <li>
              <a class="date" href={href(`/journal/${log.id}/`)}>
                <time datetime={log.data.date!.toISOString().slice(0, 10)}>{fmtDate(log.data.date!)}</time>
              </a>
              <span class="stars" aria-label={`Note : ${fmtRating(log.data.rating!)}`} title={fmtRating(log.data.rating!)}>
                {log.data.rating! > 0 ? fmtStars(log.data.rating!) : '—'}
              </span>
              <span class="meta extra">{log.data.venue ? venueLabel[log.data.venue] : '—'}</span>
              <span class="meta">{log.data.version ? versionLabel[log.data.version] : '—'}</span>
              <span class="repeat">{log.data.repeat && <RepeatIcon label="Revisionnage" />}</span>
              <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
            </li>
          ))}
        </ul>
      </>
    : <>
        <h2>Mes lectures</h2>
        <ul class="viewings readings">
          {entries.map(({ log }) => (
            <li>
              <a class="date" href={href(`/journal/${log.id}/`)}>
                {log.data.started && log.data.date ? capitalize(fmtRange(log.data.started, log.data.date))
                  : log.data.started ? `Depuis le ${fmtDate(log.data.started)}`
                  : fmtDate(log.data.date!)}
              </a>
              {log.data.rating !== undefined
                ? <span class="stars is-livre" aria-label={`Note : ${fmtRating(log.data.rating)}`} title={fmtRating(log.data.rating)}>
                    {log.data.rating > 0 ? fmtStars(log.data.rating) : '—'}
                  </span>
                : <span class="meta">{log.data.date ? '—' : 'En cours'}</span>}
              <span class="meta extra">{log.data.language ? capitalize(log.data.language) : '—'}</span>
              <span class="repeat">{log.data.repeat && <RepeatIcon label="Relecture" />}</span>
              <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
            </li>
          ))}
        </ul>
      </>}
</Base>

<style>
  /* Visionnages à la Letterboxd : date, note, lieu, version, icône de revisionnage. */
  .viewings { list-style: none; padding: 0; margin: 1.5rem 0; }
  .viewings li { display: grid; grid-template-columns: 11rem 6.5rem 1fr auto 1.25rem 1.25rem; gap: 0.25rem 2rem; align-items: center;
    padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .viewings .date { font: 600 0.95rem var(--sans); }
  .viewings .stars { font-size: 1.05rem; }
  .viewings .repeat, .viewings .review { display: flex; justify-content: center; }
  /* Lectures : la période prend plus de place qu'une date. */
  .readings li { grid-template-columns: 15rem 6.5rem 1fr 1.25rem 1.25rem; gap: 0.25rem 1.5rem; }

  /* Saisons repliables : nom, année, progression et note sur la ligne de titre. */
  .season { border-top: 1px solid var(--line); }
  .season:last-of-type { border-bottom: 1px solid var(--line); }
  .season summary { display: grid; grid-template-columns: 1fr auto 4.5rem 6.5rem; gap: 0 1.25rem; align-items: center;
    padding: 0.75rem 0; cursor: pointer; list-style: none; }
  .season summary::-webkit-details-marker { display: none; }
  .season-name { font: 600 1.05rem var(--sans); }
  .season-name::before { content: '▸'; display: inline-block; width: 1.1rem; color: var(--muted); transition: transform 0.15s; }
  .season[open] .season-name::before { transform: rotate(90deg); }
  .season .progress { text-align: right; font-variant-numeric: tabular-nums; }
  .season-body { display: grid; grid-template-columns: 6rem 1fr; gap: 1.5rem; padding: 0 0 1.25rem 1.1rem; }
  .season-body:not(:has(.season-poster)) { grid-template-columns: 1fr; }
  .season-body > div > .meta:first-child { margin: 0 0 0.5rem; }
  .season-poster { display: block; width: 100%; border-radius: 4px; box-shadow: 0 0 0 1px var(--line), 0 4px 12px rgb(0 0 0 / 0.2); }
  /* Épisodes : numéro, titre, date du dernier visionnage ; les épisodes pas encore vus sont estompés. */
  .episodes { list-style: none; padding: 0; margin: 0; font: 0.95rem/1.5 var(--sans); }
  .episodes li { display: grid; grid-template-columns: 1.75rem 1fr auto; gap: 0 0.75rem; padding: 0.2rem 0; color: var(--muted); }
  .episodes li.seen { color: var(--ink); }
  .episodes .num { font-variant-numeric: tabular-nums; color: var(--muted); }
  .episodes li.seen .num { color: var(--serie); font-weight: 600; }
  .season .viewings { margin: 1rem 0 0; }

  /* Cinq colonnes ne tiennent pas sur un écran étroit. */
  @media (max-width: 48rem) {
    /* Date, note et icônes sur la première ligne ; lieu et version en dessous. */
    .viewings li, .readings li { grid-template-columns: 1fr auto 1.25rem 1.25rem; gap: 0.25rem 0.75rem; }
    .viewings .repeat { grid-area: 1 / 3; }
    .viewings .review { grid-area: 1 / 4; }
    .viewings .extra { grid-column: 1; }
    .season summary { grid-template-columns: 1fr auto auto; }
    .season summary > .meta:nth-child(2) { display: none; }
    .season-body { grid-template-columns: 1fr; padding-left: 0; }
    .season-poster { display: none; }
  }
</style>
