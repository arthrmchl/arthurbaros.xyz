---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RepeatIcon from '../../components/RepeatIcon.astro';
import ReviewIcon from '../../components/ReviewIcon.astro';
import { getJournal, excerpt, shareImage, fmtRuntime, href, fmtDate, fmtRating, fmtStars, fmtRange, capitalize, venueLabel, versionLabel, todoLabel, typeLabel, typeRoute } from '../../lib/content';

export async function getStaticPaths() {
  const [works, journal] = await Promise.all([getCollection('works'), getJournal()]);
  return works.map((work) => ({
    params: { id: work.id },
    props: { work, entries: journal.filter((e) => e.work.id === work.id) },
  }));
}
const { work, entries } = Astro.props;
const { Content } = await render(work);
const w = work.data;
const description = excerpt(work.body) || `${typeLabel[w.type]} de ${w.creator} (${w.year}) : fiche et ${w.type === 'film' ? 'visionnages' : 'lectures'}.`;
---
<Base title={`${w.title} (${w.year}), ${w.creator}`} description={description}
  image={shareImage(w.backdrop) ?? w.poster ?? w.cover} imageAlt={w.backdrop ? `Image du film ${w.title}` : `${w.poster ? 'Affiche' : 'Couverture'} : ${w.title}`} largeImage={Boolean(w.backdrop)}>
  {w.backdrop && <div class="hero"><img src={w.backdrop} alt="" /></div>}

  <!-- Structure à la Letterboxd : affiche à gauche, informations à droite. -->
  <article class:list={['sheet', { 'has-hero': w.backdrop }]}>
    {(w.poster || w.cover) && (
      <aside class="side">
        {w.poster && <img class="poster" src={w.poster} alt={`Affiche : ${w.title}`} />}
        {w.cover && <img class="poster" src={w.cover} alt={`Couverture : ${w.title}`} />}
      </aside>
    )}

    <div class="info">
      <header class="title-line">
        <h1>{w.title}</h1>
        {w.originalTitle && <span class="original-title">{w.originalTitle}</span>}
        <span class="meta">{w.creator}&nbsp;– {w.year}</span>
      </header>
      <div class="prose"><Content /></div>
      {(w.runtime || w.originalLanguage || w.tags.length > 0) && (
        <div class="details">
          {w.runtime && <p class="meta">{fmtRuntime(w.runtime)}</p>}
          {w.originalLanguage && <p class="meta">Langue originale : {capitalize(w.originalLanguage)}</p>}
          {w.tags.length > 0 && <ul class="tags">{w.tags.map((t) => <li class:list={['pill', { 'is-livre': w.type === 'livre' }]}>{t.toLowerCase()}</li>)}</ul>}
        </div>
      )}
    </div>
  </article>

  {entries.length === 0
    ? <p class="notice">Pas encore {w.type === 'film' ? 'vu' : 'commencé'} : dans ma liste <a href={href(`/${typeRoute[w.type]}/`)}>{todoLabel[w.type].toLowerCase()}</a>.</p>
    : w.type === 'film'
    ? <>
        <h2>Mes visionnages</h2>
        <ul class="viewings">
          {entries.map(({ log }) => (
            <li>
              <a class="date" href={href(`/journal/${log.id}/`)}>
                <time datetime={log.data.date.toISOString().slice(0, 10)}>{fmtDate(log.data.date)}</time>
              </a>
              <span class="stars" aria-label={`Note : ${fmtRating(log.data.rating)}`} title={fmtRating(log.data.rating)}>
                {log.data.rating > 0 ? fmtStars(log.data.rating) : '—'}
              </span>
              <span class="meta extra">{log.data.venue ? venueLabel[log.data.venue] : '—'}</span>
              <span class="meta">{log.data.version ? versionLabel[log.data.version] : '—'}</span>
              <span class="repeat">{log.data.repeat && <RepeatIcon label="Revisionnage" />}</span>
              <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
            </li>
          ))}
        </ul>
      </>
    : <>
        <h2>Mes lectures</h2>
        <ul class="viewings readings">
          {entries.map(({ log }) => (
            <li>
              <a class="date" href={href(`/journal/${log.id}/`)}>
                {log.data.started && log.data.date ? capitalize(fmtRange(log.data.started, log.data.date))
                  : log.data.started ? `Depuis le ${fmtDate(log.data.started)}`
                  : fmtDate(log.data.date!)}
              </a>
              {log.data.rating !== undefined
                ? <span class="stars is-livre" aria-label={`Note : ${fmtRating(log.data.rating)}`} title={fmtRating(log.data.rating)}>
                    {log.data.rating > 0 ? fmtStars(log.data.rating) : '—'}
                  </span>
                : <span class="meta">{log.data.date ? '—' : 'En cours'}</span>}
              <span class="meta extra">{log.data.language ? capitalize(log.data.language) : '—'}</span>
              <span class="repeat">{log.data.repeat && <RepeatIcon label="Relecture" />}</span>
              <span class="review">{log.body?.trim() && <ReviewIcon />}</span>
            </li>
          ))}
        </ul>
      </>}
</Base>

<style>
  /* Visionnages à la Letterboxd : date, note, lieu, version, icône de revisionnage. */
  .viewings { list-style: none; padding: 0; margin: 1.5rem 0; }
  .viewings li { display: grid; grid-template-columns: 11rem 6.5rem 1fr auto 1.25rem 1.25rem; gap: 0.25rem 2rem; align-items: center;
    padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .viewings .date { font: 600 0.95rem var(--sans); }
  .viewings .stars { font-size: 1.05rem; }
  .viewings .repeat, .viewings .review { display: flex; justify-content: center; }
  /* Lectures : la période prend plus de place qu'une date. */
  .readings li { grid-template-columns: 15rem 6.5rem 1fr 1.25rem 1.25rem; gap: 0.25rem 1.5rem; }

  /* Cinq colonnes ne tiennent pas sur un écran étroit. */
  @media (max-width: 48rem) {
    /* Date, note et icônes sur la première ligne ; lieu et version en dessous. */
    .viewings li, .readings li { grid-template-columns: 1fr auto 1.25rem 1.25rem; gap: 0.25rem 0.75rem; }
    .viewings .repeat { grid-area: 1 / 3; }
    .viewings .review { grid-area: 1 / 4; }
    .viewings .extra { grid-column: 1; }
  }
</style>
