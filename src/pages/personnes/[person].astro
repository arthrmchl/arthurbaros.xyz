---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { getJournal, slugify, workItems } from '../../lib/content';

// Une page par réalisateur·ice, auteur·ice ou créateur·ice cité dans une fiche.
export async function getStaticPaths() {
  const works = await getCollection('works');
  const names = [...new Set(works.flatMap((w) => w.data.creators))];
  return names.map((name) => ({
    params: { person: slugify(name) },
    props: { name, works: works.filter((w) => w.data.creators.includes(name)) },
  }));
}
const { name, works } = Astro.props as { name: string; works: CollectionEntry<'works'>[] };
const items = workItems(works, await getJournal());
// « Réalisation de 2 films · Écriture d'un livre » : son rôle selon le type d'œuvre.
const roles = ([
  ['film', 'Réalisation', 'film', 'films'],
  ['serie', 'Création', 'série', 'séries'],
  ['livre', 'Écriture', 'livre', 'livres'],
] as const)
  .map(([type, role, one, many]) => [role, works.filter((w) => w.data.type === type).length, one, many] as const)
  .filter(([, n]) => n > 0)
  .map(([role, n, one, many]) => `${role} de ${n > 1 ? `${n} ${many}` : `${one === 'série' ? 'une' : 'un'} ${one}`}`);
---
<Base title={name} description={`${roles.join(', ')} : ${works.map((w) => w.data.title).join(', ')}.`}>
  <h1>{name}</h1>
  <p class="meta">{roles.map((r, i) => <>{i > 0 && <span class="sep">·</span>}{r}</>)}</p>
  <WorkGrid items={items} />
</Base>
