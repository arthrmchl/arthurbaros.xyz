---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Pagination from '../../../components/Pagination.astro';
import WorkGrid from '../../../components/WorkGrid.astro';
import { getJournal, kindNoun, pageSize, pageSuffix, paginate, roleLabel, slugify, workItems } from '../../../lib/content';

// Une page (ou plusieurs) par réalisateur·ice, auteur·ice ou créateur·ice cité dans une fiche.
export async function getStaticPaths() {
  const [all, journal] = await Promise.all([getCollection('works'), getJournal()]);
  const names = [...new Set(all.flatMap((w) => w.data.creators))];
  return names.flatMap((name) => {
    const works = all.filter((w) => w.data.creators.includes(name));
    return paginate(workItems(works, journal), pageSize.works).map(({ page, ...props }) => ({
      params: { person: slugify(name), page },
      props: { ...props, name, works },
    }));
  });
}
const { name, works, items, current, last } = Astro.props;
const suffix = pageSuffix(current, last);
// « Réalisation de 2 films · Écriture d'un livre · Dessin d'une BD » : son rôle (celui de `creators`, sinon celui du type d'œuvre),
// et le nom de l'œuvre selon son type ou son format. Une personne à deux rôles dans une œuvre la compte pour chacun.
const credits = works.flatMap((w) => w.data.credits.filter((c) => c.name === name)
  .map((c) => ({ role: roleLabel(c.role, w.data.type), noun: kindNoun(w.data) })));
const roles = Object.entries(Object.groupBy(credits, (c) => `${c.role}/${c.noun[1]}`))
  .map(([, list]) => {
    const { role, noun: [article, one, many] } = list![0];
    const n = list!.length;
    return `${role} ${n > 1 ? `de ${n} ${many}` : `d’${article} ${one}`}`;
  });
---
<Base title={`${name}${suffix}`} description={`${roles.join(', ')} : ${works.map((w) => w.data.title).join(', ')}${suffix}.`}>
  <h1>{name}</h1>
  <p class="meta">{roles.map((r, i) => <>{i > 0 && <span class="sep">·</span>}{r}</>)}</p>
  <WorkGrid items={items} />
  <Pagination current={current} last={last} root={`/personnes/${Astro.params.person}/`} />
</Base>
